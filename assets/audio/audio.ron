// The audio manifest: every sound and music cue, music pools and credits.
// Format: assets/audio/README.md. Decisions: docs/design/audio.md (0020),
// ADR-0026, ADR-0027. Loaded and validated by trpg_content::audio.
// Third-party files are made by assets-src/audio/import.py (0214), which
// also loudness-matches them, so every cue starts at volume 100.
(
    // How long a track fades out before the next one starts (TUNABLE,
    // audio.md "Starting values").
    music_fade_ms: 500,
    sounds: [
        // Made in-house by `cargo xtask sfx` (ticket 0213) from the recipes
        // in assets-src/audio/sound-audition.html.
        (id: "menu_move", files: ["sfx/menu_move.wav"], volume: 100, credit: Own),
        (id: "menu_select", files: ["sfx/menu_select.wav"], volume: 100, credit: Own),
        (id: "menu_cancel", files: ["sfx/menu_cancel.wav"], volume: 100, credit: Own),
        (id: "miss", files: ["sfx/miss.wav"], volume: 100, credit: Own),
        (id: "heal", files: ["sfx/heal.wav"], volume: 100, credit: Own),
        (id: "hit_sword", files: ["sfx/sword_sound_1.ogg"], volume: 100, credit: Credit("sword_sound_1")),
        // audio.md: the axe shares the spear's sound "for now".
        (id: "hit_spear", files: ["sfx/knife_stab.ogg"], volume: 100, credit: Credit("knife_stab")),
        (id: "hit_axe", files: ["sfx/knife_stab.ogg"], volume: 100, credit: Credit("knife_stab")),
        (id: "hit_bow", files: ["sfx/arrow_impact.ogg"], volume: 100, credit: Credit("arrow_impact")),
        (id: "hit_gauntlet", files: ["sfx/punch.ogg"], volume: 100, credit: Credit("punch")),
        (id: "crit_physical", files: ["sfx/deep_cut.ogg"], volume: 100, credit: Credit("deep_cut")),
        (id: "block", files: ["sfx/combat_punch_metal_armor.ogg"], volume: 100, credit: Credit("combat_punch_metal_armor")),
        (id: "cast_fire", files: ["sfx/short_fireball_woosh.ogg"], volume: 100, credit: Credit("short_fireball_woosh")),
        (id: "cast_ice", files: ["sfx/hard_glass_impact.ogg"], volume: 100, credit: Credit("hard_glass_impact")),
        (id: "hit_magic", files: ["sfx/magic_earth_spell_impact.ogg"], volume: 100, credit: Credit("magic_earth_spell_impact")),
        (id: "crit_fire", files: ["sfx/fireball_impact.ogg"], volume: 100, credit: Credit("fireball_impact")),
        (id: "crit_ice", files: ["sfx/magic_ice_impact.ogg"], volume: 100, credit: Credit("magic_ice_impact")),
        // audio.md: each step picks one of the three at random.
        (id: "step_foot", files: ["sfx/footstep_dirt_00.ogg", "sfx/footstep_dirt_gravel_4.ogg", "sfx/footstep_grass_5.ogg"],
         volume: 100, credit: Credits(["footstep_dirt_00", "footstep_dirt_gravel_4", "footstep_grass_5"])),
        (id: "step_armored", files: ["sfx/knight_footstep_gravel_5.ogg"], volume: 100, credit: Credit("knight_footstep_gravel_5")),
        (id: "step_mounted", files: ["sfx/galloping_horse_step.ogg"], volume: 100, credit: Credit("galloping_horse")),
    ],
    music: [
        (id: "title", file: "new_sunrise_v1.ogg", volume: 100, credit: Credit("new_sunrise")),
        (id: "city_first_visit", file: "new_sunrise_v2.ogg", volume: 100, credit: Credit("new_sunrise")),
        (id: "village_home", file: "squirrel_village_loop.ogg", volume: 100, credit: Credit("squirrel_village")),
        (id: "village", file: "aria.ogg", volume: 100, credit: Credit("aria")),
        (id: "dungeon_tense", file: "dark_forest_theme.ogg", volume: 100, credit: Credit("dark_forest_theme")),
        (id: "graveyard_desert", file: "dark_quest.ogg", volume: 100, credit: Credit("dark_quest")),
        (id: "side_quest", file: "fathers_scabbard_loop.ogg", volume: 100, credit: Credit("fathers_scabbard")),
        (id: "talk_calm", file: "field_orchestra.ogg", volume: 100, credit: Credit("field_orchestra")),
        (id: "talk_antagonist", file: "classical_murder.ogg", volume: 100, credit: Credit("classical_murder")),
        (id: "scene_sad", file: "peractorum.ogg", volume: 100, credit: Credit("peractorum")),
        (id: "scene_tragic", file: "hesitation_orchestral.ogg", volume: 100, credit: Credit("hesitation")),
        (id: "mythic_moment", file: "epic_endgame_cinematic.ogg", volume: 100, credit: Credit("epic_endgame_cinematic")),
        (id: "battle_bright", file: "hope_orchestral_battle.ogg", volume: 100, credit: Credit("hope")),
        (id: "battle_bittersweet", file: "battle_mla.ogg", volume: 100, credit: Credit("battle_mla")),
        (id: "battle_easy", file: "sigil.ogg", volume: 100, credit: Credit("sigil")),
        (id: "battle_new_area", file: "ending_scene_orchestral.ogg", volume: 100, credit: Credit("ending_scene")),
        (id: "battle_epic_a", file: "battle_theme_a.ogg", volume: 100, credit: Credit("battle_theme_a")),
        (id: "battle_epic_b", file: "battle_theme_b.ogg", volume: 100, credit: Credit("battle_theme_b")),
        (id: "battle_church_2", file: "fantasy_choir_2.ogg", volume: 100, credit: Credit("fantasy_choir")),
        (id: "battle_church_3", file: "fantasy_choir_3.ogg", volume: 100, credit: Credit("fantasy_choir")),
        // The skirmish pool's tracks (pools below).
        (id: "skirmish_zhelanov_1", file: "zhelanov_battle_theme_1.ogg", volume: 100, credit: Credit("zhelanov_battle_themes")),
        (id: "skirmish_zhelanov_2", file: "zhelanov_battle_theme_2.ogg", volume: 100, credit: Credit("zhelanov_battle_themes")),
        (id: "skirmish_zhelanov_3", file: "zhelanov_battle_theme_3.ogg", volume: 100, credit: Credit("zhelanov_battle_themes")),
        (id: "skirmish_zhelanov_5", file: "zhelanov_battle_theme_5.ogg", volume: 100, credit: Credit("zhelanov_battle_themes")),
        (id: "skirmish_jocolloman", file: "rpg_battle_theme.ogg", volume: 100, credit: Credit("rpg_battle_theme")),
    ],
    pools: [
        // Skirmishes pick one at random per battle (audio.md rule 8; 0807).
        (id: "skirmish", music: ["skirmish_zhelanov_1", "skirmish_zhelanov_2", "skirmish_zhelanov_3",
                                 "skirmish_zhelanov_5", "skirmish_jocolloman"]),
    ],
    credits: [
        // Music (one entry per work; the note names the file or version).
        (id: "new_sunrise", title: "New Sunrise", author: "nene",
         source: "https://opengameart.org/content/new-sunrise", license: "CC0-1.0",
         tags: ["music", "title", "city_first_visit", "calm", "hopeful", "city", "orchestral"],
         note: "V1 (New Sunrise.wav) for the title screen; V2 (new_sunrise_V2_0.wav) for a first city visit"),
        (id: "squirrel_village", title: "Squirrel Village", author: "SoManyWhales",
         source: "https://opengameart.org/content/squirrel-village", license: "CC-BY-4.0",
         tags: ["music", "village_home", "calm", "idyllic", "village", "woodwinds", "strings"],
         note: "SV_loop.mp3 (the loop file) from squirrelvillage.zip"),
        (id: "aria", title: "Aria", author: "Kistol",
         source: "https://opengameart.org/content/aria", license: "CC0-1.0",
         tags: ["music", "village", "calm", "small village", "medium village"],
         note: "Aria_2.ogg"),
        (id: "dark_forest_theme", title: "Dark Forest Theme", author: "cynicmusic",
         source: "https://opengameart.org/content/dark-forest-theme", license: "CC0-1.0",
         tags: ["music", "dungeon_tense", "tense", "dark", "dungeon", "acoustic guitar", "strings"],
         note: "GameMusic_ForestTheme_24_0.mp3"),
        (id: "dark_quest", title: "Dark Quest", author: "Alexandr Zhelanov",
         source: "https://opengameart.org/content/dark-quest", license: "CC-BY-4.0",
         tags: ["music", "graveyard_desert", "dark", "graveyard", "desert"],
         note: "Dark Quest.ogg"),
        (id: "fathers_scabbard", title: "Father's Scabbard", author: "SoManyWhales",
         source: "https://opengameart.org/content/fathers-scabbard", license: "CC-BY-4.0",
         tags: ["music", "side_quest", "adventurous", "side quest", "companion"],
         note: "Father's Scabbard - Loop.wav (the loop file) from fathers_scabbard.zip"),
        (id: "field_orchestra", title: "Field - Orchestra", author: "migfus20",
         source: "https://opengameart.org/content/field-orchestra", license: "CC-BY-4.0",
         tags: ["music", "talk_calm", "calm", "conversation", "orchestral"],
