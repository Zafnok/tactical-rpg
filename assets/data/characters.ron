// PLACEHOLDER until 0701: test characters and generic enemy templates, so the
// rules can be built and tested before the real cast exists. The story
// tickets (07xx) replace this whole file. Loaded by trpg_content::character.
//
// characters: named characters.
//   id: also the character's name id: the display name is its entry in
//     names.ron (ticket 0709), never written here.
//   base is in stat order (HP, Str, Mag, Dex, Spd, Def, Res) (Mov comes from
//   the class) and must be <= the hard ceilings (classes.ron).
//   talent: the +20% growth stat (not Mov).
//   weapon_ranks: (kind, rank); raised to the class's start ranks on entry.
//   personal_spells: (character level, spell id), at most 2; none for the lord.
//   is_lord: only the lord may start in a lord-only class.
//   map_label (optional, characters and generics): Some("Xy"), the two letters drawn on
//     the map, instead of the first two letters of the name (generics: of
//     the class name). Named units of one side on a map need distinct labels.
//   loadout (optional, characters and generics): (weapons: [ids], armour:
//     Some(id), accessory: Some(id)), items from items.ron; at most the
//     class's weapon slots, armour of a weight the class wears. The first
//     weapon the unit can wield starts equipped.
// generics: generic unit templates (class + character level); their stats
//   come from the class (progression.md, "Generic units").
(
    characters: [
        // The lead (ticket 0708): the player picks the gender and first
        // name at New Game, so dialogue shows the chosen name and the
        // portrait lead_m or lead_f. Stats are a copy of test_lord's.
        (
            id: "lead", class: "exile", level: 1, is_lord: true,
            map_label: Some("El"),
            talent: Spd,
            base: (19, 6, 1, 7, 7, 4, 3),
            weapon_ranks: [(Sword, D)],
            loadout: (weapons: ["iron_sword", "steel_sword"], armour: Some("leather_vest")),
        ),
        (
            id: "test_lord", class: "exile", level: 1, is_lord: true,
            map_label: Some("Lo"),
            talent: Spd,
            base: (19, 6, 1, 7, 7, 4, 3),
            weapon_ranks: [(Sword, D)],
            loadout: (weapons: ["iron_sword", "steel_sword"], armour: Some("leather_vest")),
        ),
        (
            id: "test_knight", class: "guard", level: 1,
            map_label: Some("Kn"),
            talent: Def,
            base: (20, 7, 0, 4, 2, 9, 0),
            weapon_ranks: [(Spear, D)],
            loadout: (weapons: ["iron_spear"], armour: Some("chain_mail")),
        ),
        (
            id: "test_archer", class: "archer", level: 1,
            map_label: Some("Ar"),
            talent: Dex,
            base: (17, 5, 0, 7, 5, 3, 1),
            weapon_ranks: [(Bow, D)],
            loadout: (weapons: ["iron_bow"], armour: Some("leather_vest")),
        ),
        // An enemy the lord can talk into joining: the debug Quick
        // Battle's trigger fixture (ticket 0705).
        (
            id: "test_rogue", class: "raider", level: 2,
            map_label: Some("Ro"),
            talent: Str,
            base: (22, 7, 0, 3, 4, 4, 0),
            weapon_ranks: [(Axe, D)],
            loadout: (weapons: ["iron_axe"]),
        ),
        // The debug Quick Battle's caster (ticket 0410): Fire from the
        // class; Frost (a Mage's level-5 spell) and Heal as personal spells,
        // so one unit can try every kind of cast.
        (
            id: "test_mage", class: "mage", level: 1,
            map_label: Some("Ma"),
            talent: Mag,
            base: (16, 1, 6, 5, 5, 1, 5),
            weapon_ranks: [],
            personal_spells: [(1, "frost"), (1, "heal")],
            loadout: (armour: Some("leather_vest")),
        ),
    ],
    generics: [
        (id: "test_brigand", class: "brigand", level: 1, loadout: (weapons: ["iron_axe"])),
        // The debug Quick Battle's elemental (Nick, ticket 0410).
        (id: "test_frost_elemental", class: "frost_elemental", level: 1),
        (
            id: "test_raider", class: "raider", level: 2,
            loadout: (weapons: ["steel_axe", "iron_axe"]),
        ),
    ],
)
