    //              (HP, Str, Mag, Dex, Spd, Def, Res)
    hard_ceilings: (80, 50, 50, 50, 50, 50, 50),
    mov_ceiling: 15,
    // Per tier, index 0 = tier 1. Both must never decrease as the tier rises.
