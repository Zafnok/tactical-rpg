    "faction.red_company": "the Red Company",
    "faction.league": "the Saltmere League",
    "house.veyne": "House Veyne",
    "group.candles": "the Candles",

    // Gods and magic terms.
    "god.mother": "Ama, the Mother",
    "god.pyre": "Vael, the Pyre",
    "god.winter": "Hrim, the Long Winter",
    "god.hand": "Orun, the Hand",
