// The names table (ticket 0709): every display name in the game's data, by
// stable id. It's the only place a name is written: characters.ron takes a
// named character's name from here (its id is the name id), and .dlg text
// writes {n:<id>} (or {N:<id>} for a capital first letter) instead of the
// name. To rename, change the value here; see docs/story/names.md, "How
// renaming works". Loaded by trpg_content::names.
//
// Ids: lowercase letters, digits, _ and ., as in docs/story/names.md (every
// id there must be here). Values: plain ASCII, no { or }, each unique. Keep
// the leading "the" where the name has one ("the Thornmarch"), so a token
// reads right mid-sentence.
{
    // Characters (docs/story/names.md). The lead's name is the player's
    // choice: dialogue writes {lead}; this is only the default.
    "lead": "Ellery",
    "retainer": "Hollis Marr",
    "sergeant": "Tamsin Rook",
    "poacher": "Aske",
    "keeper": "Piers",
    "heretic": "Rue",
    "rival": "Dace Marr",
    "king": "Emeric",
    "vowmaster": "Absalom Crane",
    "red_captain": "Harl Coster",
    "sister": "Wren Marr",
    "prince": "Aurel",
    "vosse": "Harrick Vosse",
    "defector": "Joss Pellam",
    "prizefighter": "Gil Parrow",
    "shieldbearer": "Hedda Ravn",
    "envoy": "Ragna Holt",
    "battlemage": "Oriel Mast",

    // Places.
    "place.west": "the Old Kingdoms",
    "place.east": "the Jade Reach",
    "place.south": "the Sunward Isles",
    "place.ardeval": "Ardeval",
    "place.capital": "Varenhall",
    "place.brennmark": "Brennmark",
    "place.thornmarch": "the Thornmarch",
    "place.harrowby": "Harrowby",
    "place.veyne_hall": "Veyne Hall",
    "place.ashfields": "the Ashfields",
    "place.ossary": "Ossary",
    "place.greywater": "Greywater Abbey",
    "place.saltmere": "Saltmere",
    "place.kells_ford": "Kell's Ford",
    "place.millhaven": "Millhaven",
    "place.cairnford": "Cairnford",

    // Factions, houses and groups.
    "faction.crown": "the Crown of Ardeval",
    "faction.hounds": "the Hounds",
    "faction.vigil": "the Vigil",
    "faction.brennmark": "the Brennish",
