// One-time tips (ticket 0406, docs/design/chapter-1.md "Teaching"): each is
// shown once per profile, the first time its trigger happens in a battle.
// Text is at most 3 lines of 60 characters; {Action} is replaced with the
// key bound to that action (e.g. {Confirm}), and {Cursor} with the keys that
// move the cursor, so rebinding stays correct.
//
// Triggers: FirstBattleStart, FirstUnitSelected, FirstEnemyInRange,
// FirstForecast, FirstLowHp, FirstLevelUp, FirstEnemyPhase,
// DangerZoneAvailable. At most one tip per trigger.
(
    tips: [
        (
            id: "battle_start",
            trigger: FirstBattleStart,
            title: "Your move",
            text: "Steer the cursor with {Cursor}. Press {Confirm} on one of\nyour units to select it. {NextUnit} jumps to the next unit\nthat can still act; {Info} shows a unit's details.",
        ),
        (
            id: "unit_selected",
            trigger: FirstUnitSelected,
            title: "Moving a unit",
            text: "Blue tiles are where it can move, red where it can\nattack. Steer to a blue tile and press {Confirm} to move;\n{Cancel} backs out.",
        ),
        (
            id: "enemy_in_range",
            trigger: FirstEnemyInRange,
            title: "Enemy in reach",
            text: "A red tile holds an enemy this unit can attack after\nmoving. Move there, then pick Attack from the menu.",
        ),
        (
            id: "forecast",
            trigger: FirstForecast,
            title: "Attack forecast",
            text: "The panel shows damage, hit chance and who strikes\nfirst. {Cursor} picks the target, {Confirm} attacks,\n{Cancel} goes back without spending the turn.",
        ),
        (
            id: "low_hp",
            trigger: FirstLowHp,
            title: "Low HP",
            text: "A unit is badly hurt. Pull it back, or use a Potion\nfrom its item menu. {Rewind} undoes a mistake.",
        ),
        (
            id: "level_up",
            trigger: FirstLevelUp,
            title: "Level up!",
            text: "Fighting earns EXP. At 100 EXP a unit gains a level and\nits stats can grow. Check the new numbers with {Info}.",
        ),
        (
            id: "enemy_phase",
            trigger: FirstEnemyPhase,
            title: "Enemy phase",
            text: "Now the enemy moves and attacks. Watch what they do:\nit shows where the danger is. {Confirm} skips the banner.",
        ),
        (
            id: "danger_zone",
            trigger: DangerZoneAvailable,
            title: "Danger zone",
            text: "Press {DangerZone} to tint every tile the enemy could hit\nnext turn. Press it again to hide it. {Confirm} on an enemy\nshows just its range.",
        ),
    ],
)
