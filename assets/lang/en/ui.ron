// English screen text, by key (ADR-0045). Screens ask for it with
// `ctx.text("title.new_game")`. Keys are `screen.thing`: lowercase letters,
// digits, `_` and `.`.
//
// `{Confirm}`, `{Cancel}`, `{Cursor}` and the other action names become
// the player's keys (never write a key's name here); any other `{name}` is
// a value the screen fills in.
{
    // The title screen.
    "title.title": "Visions of Shuyi",
    "title.subtitle": "an ASCII tactics game",
    "title.press_any_key": "Press any key",
    "title.continue": "Continue",
    "title.new_game": "New Game",
    "title.load_game": "Load Game",
    "title.quick_battle": "Quick Battle",
    "title.credits": "Credits",
    "title.quit": "Quit",
    "title.help": "{Cursor} move · {Confirm} select · {Cancel} back",

    // The Key bindings screen: the text its controller side added (ticket
    // 0816). The rest of the screen's text moves here with ticket 0234.
    "key_bindings.keyboard": "Keyboard",
    "key_bindings.controller": "Controller",
    "key_bindings.button_column": "Button {n}",
    "key_bindings.must_have_button": "Must have a button",
    "key_bindings.optional": "Optional",
    "key_bindings.change": "Change",
    "key_bindings.clear": "Clear",
    "key_bindings.hold_to_cancel": "hold any button to cancel",
    "key_bindings.restore_buttons": "Restore the default buttons?",
    "key_bindings.blocked_button": "Give {action} a button first",
    "key_bindings.help_choice": "{Cursor} move · {Confirm} select · {Cancel} back",
    "key_bindings.help_switch": "{CursorLeft}/{CursorRight} keyboard or controller · {Cursor} move · {Cancel} back",
    "key_bindings.help_slot_pad": "{Cursor} move · {Confirm} change · {Cancel} back",
}
