// The test pack's screen text: each entry is the English in capitals.
// Kept on purpose: `title.subtitle` is stale (its `source` is not today's
// English) and `title.credits` is missing, so both show in English.
[
    (key: "title.title", source: "Visions of Shuyi", text: "VISIONS OF SHUYI"),
    (key: "title.subtitle", source: "an ASCII strategy game", text: "AN ASCII STRATEGY GAME"),
    (key: "title.press_any_key", source: "Press any key", text: "PRESS ANY KEY"),
    (key: "title.continue", source: "Continue", text: "CONTINUE"),
    (key: "title.new_game", source: "New Game", text: "NEW GAME"),
    (key: "title.load_game", source: "Load Game", text: "LOAD GAME"),
    (key: "title.quick_battle", source: "Quick Battle", text: "QUICK BATTLE"),
    (key: "title.quit", source: "Quit", text: "QUIT"),
    (
        key: "title.help",
        source: "{Cursor} move · {Confirm} select · {Cancel} back",
        text: "{Cursor} MOVE · {Confirm} SELECT · {Cancel} BACK",
    ),
    // The Key bindings screen (ticket 0816).
    (key: "key_bindings.keyboard", source: "Keyboard", text: "KEYBOARD"),
    (key: "key_bindings.controller", source: "Controller", text: "CONTROLLER"),
    (key: "key_bindings.button_column", source: "Button {n}", text: "BUTTON {n}"),
    (
        key: "key_bindings.must_have_button",
        source: "Must have a button",
        text: "MUST HAVE A BUTTON",
    ),
    (key: "key_bindings.optional", source: "Optional", text: "OPTIONAL"),
    (key: "key_bindings.change", source: "Change", text: "CHANGE"),
    (key: "key_bindings.clear", source: "Clear", text: "CLEAR"),
    (
        key: "key_bindings.hold_to_cancel",
        source: "hold any button to cancel",
        text: "HOLD ANY BUTTON TO CANCEL",
    ),
    (
        key: "key_bindings.restore_buttons",
        source: "Restore the default buttons?",
        text: "RESTORE THE DEFAULT BUTTONS?",
    ),
    (
        key: "key_bindings.blocked_button",
        source: "Give {action} a button first",
        text: "GIVE {action} A BUTTON FIRST",
    ),
    (
        key: "key_bindings.help_choice",
        source: "{Cursor} move · {Confirm} select · {Cancel} back",
        text: "{Cursor} MOVE · {Confirm} SELECT · {Cancel} BACK",
    ),
    (
        key: "key_bindings.help_switch",
